{
  "name": "depbot-policy",
  "version": "0.1.0",
  "description": "One policy file → dependabot.yml, a safe auto-merge workflow, a block list, and a weekly review rotation",
  "keywords": [
    "dependabot",
    "github-actions",
    "auto-merge",
    "dependencies",
    "cli"
  ],
  "homepage": "https://github.com/heyhadi/depbot-policy#readme",
  "bugs": "https://github.com/heyhadi/depbot-policy/issues",
  "license": "MIT",
  "author": "Munawirul Hadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyhadi/depbot-policy.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "depbot-policy": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "node src/bin.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
